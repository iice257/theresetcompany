{
  "name": "the-reset-company",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-browser.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/build-browser.mjs && next build && node scripts/finish-export.mjs",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "check:content": "node --experimental-strip-types scripts/check-content.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.6.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
